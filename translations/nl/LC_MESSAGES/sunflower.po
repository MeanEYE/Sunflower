#: sunflower/operation.py:115
#, python-brace-format
msgid ""
"Aborted. Not enough free space on target file system.\n"
"Needed: {0}\n"
"Available: {1}"
msgstr "Afgebroken. Onvoldoende vrije ruimte op het doel- bestandssysteem.\nBenodigd: {0}\nBeschikbaar: {1}"

#: sunflower/operation.py:130
#, python-brace-format
msgid ""
"Target file system does not have enough free space for this operation to continue.\n"
"\n"
"Needed: {0}\n"
"Available: {1}\n"
"\n"
"Do you wish to continue?"
msgstr "Het doelbestandssysteem heeft onvoldoende vrije ruimte voor deze actie.\n\nBenodigd: {0}\nBeschikbaar: {1}\n\nWilt u doorgaan?"

#: sunflower/operation.py:265
msgid ""
"There is a problem writing data to destination file. What would you like to "
"do?"
msgstr "Er is een probleem opgetreden bij het wegschrijven van gegevens naar het doelbestand. Wat wilt u doen?"

#: sunflower/operation.py:307
msgid ""
"An error occurred while trying to create specified file. What would you like"
" to do?"
msgstr "Er is een fout opgetreden bij het aanmaken van het opgegeven bestand. Wat wilt u doen?"

#: sunflower/operation.py:314
msgid ""
"An error occurred while trying to create specified directory. What would you"
" like to do?"
msgstr "Er is een fout opgetreden bij het aanmaken van de opgegeven map. Wat wilt u doen?"

#: sunflower/operation.py:354
msgid ""
"Problem with setting path parameter for specified path. What would you like "
"to do?"
msgstr "Er is een probleem opgetreden bij het instellen van de aanvullende optie bij de opgegeven locatie. Wat wilt u doen? "

#: sunflower/operation.py:393
msgid ""
"There was a problem removing specified path. What would you like to do?"
msgstr "Er is een probleem opgetreden bij het verwijderen van de opgegeven locatie. Wat wilt u doen?"

#: sunflower/operation.py:432
msgid ""
"There was a problem trashing specified path. Would you like to try removing "
"it instead?"
msgstr "Er is een probleem opgetreden bij het verplaatsen van de opgegeven locatie naar de prullenbak. Wilt u het permanent verwijderen?"

#: sunflower/operation.py:471
msgid "There was a problem moving specified path. What would you like to do?"
msgstr "Er is een probleem opgetreden bij het verplaatsen van de opgegeven locatie. Wat wilt u doen?"

#: sunflower/operation.py:510
msgid ""
"There was a problem renaming specified path. What would you like to do?"
msgstr "Er is een probleem opgetreden bij de naamswijziging van de opgegeven locatie. Wat wilt u doen?"

#: sunflower/operation.py:549
msgid ""
"There was a problem with reading specified directory. What would you like to"
" do?"
msgstr "Er is een probleem opgetreden bij het uitlezen van de opgegeven map. Wat wilt u doen?"

