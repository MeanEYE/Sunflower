#, python-brace-format
msgid ""
"Aborted. Not enough free space on target file system.\n"
"Needed: {0}\n"
"Available: {1}"
msgstr "Megszakítva. Nincs elég szabad hely a cél fájlrendszeren.\nSzükséges: {0}\nElérhető: {1}"

#: sunflower/operation.py:130
#, python-brace-format
msgid ""
"Target file system does not have enough free space for this operation to continue.\n"
"\n"
"Needed: {0}\n"
"Available: {1}\n"
"\n"
