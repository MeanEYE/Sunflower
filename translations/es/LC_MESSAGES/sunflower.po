#: sunflower/operation.py:115
#, python-brace-format
msgid ""
"Aborted. Not enough free space on target file system.\n"
"Needed: {0}\n"
"Available: {1}"
msgstr "Operación interrumpida. No hay suficiente espacio libre en el sistema de archivos destino.\nEspacio necesario: {0}\nEspacio disponible: {1}"

#: sunflower/operation.py:130
#, python-brace-format
msgid ""
"Target file system does not have enough free space for this operation to continue.\n"
"\n"
"Needed: {0}\n"
"Available: {1}\n"
"\n"
"Do you wish to continue?"
msgstr "No hay suficiente espacio libre en el sistema de archivos destino para completar la operación.\n\nEspacio necesario: {0}\nEspacio disponible: {1}\n\n¿Quiere continuar?"

#: sunflower/operation.py:265
msgid ""
"There is a problem writing data to destination file. What would you like to "
"do?"
msgstr "Se ha producido un problema al escribir datos en el archivo destino. ¿Qué quiere hacer?"

#: sunflower/operation.py:307
msgid ""
"An error occurred while trying to create specified file. What would you like"
" to do?"
msgstr "Se ha producido un error al intentar crear el archivo especificado. ¿Qué quiere hacer?"

#: sunflower/operation.py:314
msgid ""
"An error occurred while trying to create specified directory. What would you"
" like to do?"
msgstr "Se ha producido un error al intentar crear la carpeta especificada. ¿Qué quiere hacer?"

#: sunflower/operation.py:354
msgid ""
"Problem with setting path parameter for specified path. What would you like "
"to do?"
msgstr "Se ha producido un problema al configurar los parámetros de la ruta especificada. ¿Qué quiere hacer?"

#: sunflower/operation.py:393
msgid ""
"There was a problem removing specified path. What would you like to do?"
msgstr "Se ha producido un problema al eliminar la ruta especificada. ¿Qué quiere hacer?"

