#: sunflower/operation.py:115
#, python-brace-format
msgid ""
"Aborted. Not enough free space on target file system.\n"
"Needed: {0}\n"
"Available: {1}"
msgstr "Ματαίωση. Δεν υπάρχει αρκετός διαθέσιμος χώρος στο σύστημα αρχείων\nΑπαιτούμενος χώρος: {0}\nΔιαθέσιμος χώρος: {1}"

#: sunflower/operation.py:130
#, python-brace-format
msgid ""
"Target file system does not have enough free space for this operation to continue.\n"
"\n"
"Needed: {0}\n"
"Available: {1}\n"
"\n"
"Do you wish to continue?"
msgstr "Το σύστημα αρχείων δεν έχει αρκετό ελεύθερο χώρο για τη συνέχιση της εργασίας.\n\nΑπαιτούμενος χώρος: {0}\nΔιαθέσιμος χώρος: {1}\n\nΘα θέλατε να συνεχίσετε;"

#: sunflower/operation.py:265
msgid ""
"There is a problem writing data to destination file. What would you like to "
"do?"
msgstr "Υπήρξε πρόβλημα κατά την εγγραφή δεδομένων στο αρχείο προορισμού. Τι θα θέλατε να κάνετε;"

#: sunflower/operation.py:307
msgid ""
"An error occurred while trying to create specified file. What would you like"
" to do?"
msgstr "Ένα σφάλμα συνέβη κατά τη δημιουργία του συγκεκριμένου αρχείου. Τι θα θέλατε να κάνετε;"

#: sunflower/operation.py:314
msgid ""
"An error occurred while trying to create specified directory. What would you"
" like to do?"
msgstr "Ένα σφάλμα συνέβη με τη δημιουργία του συγκεκριμένου καταλόγου. Τι θα θέλατε να κάνετε;"

#: sunflower/operation.py:354
msgid ""
"Problem with setting path parameter for specified path. What would you like "
"to do?"
msgstr "Πρόβλημα με τον ορισμό παραμέτρου διαδρομής για τη συγκεκριμένη διαδρομή. Τι θα θέλατε να κάνετε;"

#: sunflower/operation.py:393
msgid ""
"There was a problem removing specified path. What would you like to do?"
msgstr "Υπήρξε πρόβλημα με την αφαίρεση της συγκεκριμένης διαδρομής. Τι θα θέλατε να κάνετε;"

#: sunflower/operation.py:432
msgid ""
"There was a problem trashing specified path. Would you like to try removing "
"it instead?"
msgstr "Υπήρξε πρόβλημα με την μεταφορά στα απορρίμματα της συγκεκριμένης διαδρομής. Τι θα θέλατε να κάνετε;"

#: sunflower/operation.py:471
msgid "There was a problem moving specified path. What would you like to do?"
msgstr "Υπήρξε πρόβλημα με την μετακίνηση της συγκεκριμένης διαδρομής. Τι θα θέλατε να κάνετε;"

#: sunflower/operation.py:510
msgid ""
"There was a problem renaming specified path. What would you like to do?"
msgstr "Υπήρξε ένα πρόβλημα με την μετονομασία της συγκεκριμένης διαδρομής. Τι θα θέλατε να κάνετε;"

#: sunflower/operation.py:549
msgid ""
"There was a problem with reading specified directory. What would you like to"
" do?"
msgstr "Υπήρξε πρόβλημα με την ανάγνωση του συγκεκριμένου καταλόγου. Τι θα θέλατε να κάνετε;"

