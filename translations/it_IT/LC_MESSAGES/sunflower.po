#: sunflower/operation.py:115
#, python-brace-format
msgid ""
"Aborted. Not enough free space on target file system.\n"
"Needed: {0}\n"
"Available: {1}"
msgstr "Operazione fallita. Non c'è abbastanza spazio libero nel file system di destinazione.\nNecessario: {0}\nDisponibile: {1}"

#: sunflower/operation.py:130
#, python-brace-format
msgid ""
"Target file system does not have enough free space for this operation to continue.\n"
"\n"
"Needed: {0}\n"
"Available: {1}\n"
"\n"
"Do you wish to continue?"
msgstr "Il file system di destinazione non ha abbastanza spazio libero per completare l'operazione.\n\nNecessario: {0}\nDisponibile: {1}\n\nVuoi proseguire?"

#: sunflower/operation.py:265
msgid ""
"There is a problem writing data to destination file. What would you like to "
"do?"
msgstr "Si è verificato un problema durante la scrittura dei dati nel file di destinazione. Cosa vuoi fare?"

#: sunflower/operation.py:307
msgid ""
"An error occurred while trying to create specified file. What would you like"
" to do?"
msgstr "Si è verificato un errore durante il tentativo di creare il file specificato. Cosa vuoi fare?"

#: sunflower/operation.py:314
msgid ""
"An error occurred while trying to create specified directory. What would you"
" like to do?"
msgstr "Si è verificato un errore durante il tentativo di creare la directory specificata. Cosa vuoi fare?"

#: sunflower/operation.py:354
msgid ""
"Problem with setting path parameter for specified path. What would you like "
"to do?"
msgstr "Problema con l'impostazione del parametro percorso per il percorso specificato. Cosa vuoi fare?"

#: sunflower/operation.py:393
msgid ""
"There was a problem removing specified path. What would you like to do?"
